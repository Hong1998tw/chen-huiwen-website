{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.huiwen.tw/schema/public-achievement.schema.json",
  "title": "Public achievement projection v1",
  "description": "The repository source and runtime projection contain only publication-ready achievement records and explicit public fields. Review notes, evidence workflow metadata and unapproved records remain outside this public repository.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "scope": {
        "type": "string"
      },
      "district": {
        "type": "string"
      },
      "locationName": {
        "type": "string"
      },
      "locationNote": {
        "type": "string"
      },
      "updated": {
        "type": "string"
      },
      "budget": {
        "type": "string"
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "subcategories": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "villages": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "paragraphs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "sectionOrder": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "string",
          "enum": [
            "overview",
            "media",
            "history",
            "sources"
          ]
        }
      },
      "images": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "related": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "status": {
        "type": "string",
        "enum": [
          "持續追蹤",
          "爭取規劃",
          "政策實施",
          "已完成"
        ]
      },
      "coordinates": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "published": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "history": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "date",
            "title",
            "text"
          ]
        }
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "sourceType": {
              "type": "string"
            },
            "sourceDate": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "title",
            "url"
          ]
        }
      },
      "imageDimensions": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "imageMetadata": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alt": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "credit": {
              "type": "string"
            },
            "sourceUrl": {
              "type": "string"
            }
          },
          "required": [
            "alt",
            "caption",
            "credit",
            "sourceUrl"
          ]
        }
      },
      "media": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "photo",
                "video"
              ]
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "alt": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "credit": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url",
            "alt",
            "caption",
            "credit"
          ]
        }
      },
      "villageHeadPartners": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "village": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "sourceType": {
                  "type": "string"
                },
                "sourceDate": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "title",
                "url"
              ]
            }
          },
          "required": []
        }
      },
      "funding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "basis": {
            "type": "string",
            "enum": [
              "核定總經費"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "TWD"
            ]
          },
          "total": {
            "type": "integer"
          },
          "centralGrant": {
            "type": "integer"
          },
          "approvedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "approvalReference": {
            "type": "string",
            "minLength": 1
          },
          "collaboration": {
            "type": "string",
            "minLength": 1
          },
          "sourceTitle": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "required": [
          "basis",
          "currency",
          "total",
          "centralGrant",
          "approvedOn",
          "approvalReference",
          "collaboration",
          "sourceTitle",
          "sourceUrl"
        ]
      }
    },
    "required": [
      "id",
      "title",
      "summary",
      "status",
      "categories",
      "updated",
      "sources",
      "history"
    ]
  }
}
