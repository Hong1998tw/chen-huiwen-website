{
  "$schema": "../admin/node_modules/wrangler/config-schema.json",
  // 慧文政績島布告欄的公開 API。只開 board.huiwen.tw，不開 workers.dev 與預覽網址。
  "name": "huiwen-board",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "routes": [
    { "pattern": "board.huiwen.tw", "custom_domain": true }
  ],
  // 與 CMS（admin/wrangler.jsonc）同一個 D1；遷移檔只放在 admin/migrations，一律從 CMS 設定套用。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huiwen-cms",
      "database_id": "a1ca9953-77b4-49af-b3b6-415533e09061",
      "migrations_dir": "../admin/migrations"
    }
  ],
  // 每小時：清空滿 1 天的 ip_hash；2026-12-28 00:00（台北）起刪除全部留言。
  "triggers": { "crons": ["17 * * * *"] },
  // 機密（不放這裡）：wrangler secret put TURNSTILE_SECRET / IP_SALT --config board/wrangler.jsonc
  "vars": {
    // 前端用的 Turnstile site key（公開值）；建立 widget 後替換。前端由 createBoard({ siteKey }) 取用。
    "TURNSTILE_SITEKEY": "REPLACE_WITH_TURNSTILE_SITEKEY"
  }
}
