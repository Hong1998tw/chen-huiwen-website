      "role": "網站工程維護",
      "assignmentStatus": "unassigned",
      "person": null,
      "backupPerson": null
    }
  ],
  "publishingRoles": {
    "scope": "Notion Pilot（活動、律師時間表）發布角色；只記錄是否已指定，人員識別資料只保存在私有 Notion 發布中心，不寫入公開 repo。",
    "productionAuthorization": "Pilot 期間 Notion「要求發布」只是發布請求與候選版本核准；Production merge 由 GitHub human review 把關。",
    "identityBinding": "WP0.7 未通過前，不以 Notion last_edited_by 或勾選者宣稱 Editor／Publisher 分權已 enforce。",
    "roles": [
      {
        "id": "pilot-editor",
        "role": "Editor：編輯活動與律師時間表",
        "assignmentStatus": "unassigned"
      },
      {
        "id": "pilot-publisher",
        "role": "Publisher：確認白話預覽並勾選要求發布（候選版本核准）",
        "assignmentStatus": "unassigned"
      },
      {
        "id": "pilot-publisher-backup",
        "role": "Publisher 代理人",
        "assignmentStatus": "unassigned"
      },
      {
        "id": "pilot-github-reviewer",
        "role": "GitHub human reviewer：Pilot 期間最終 Production 授權（審核並合併 PR）",
        "assignmentStatus": "unassigned"
      }
    ]
  },
  "checks": [
    {
      "id": "legal-schedule-month",
      "kind": "monthly_schedule",
      "source": "data/legal-schedule.json",
      "ownerId": "service-information",
      "reviewTask": "核對服務處原始圖卡，更新文字時間表與核對日期；不得推定名額。"
    },
    {
      "id": "event-lifecycle",
      "kind": "events",
      "source": "data/events.json",
      "ownerId": "service-information",
      "reviewTask": "核對近期公開行程的時間、取消或改期及原公告。"
    },
    {
      "id": "public-record-freshness",
      "kind": "records",
      "source": "data/achievements.json",
      "ownerId": "public-records",
      "reviewAgeDays": 180,
      "statuses": ["持續追蹤", "爭取規劃", "政策實施"],
      "reviewTask": "請人工核對主管機關最新公開資料，補充可追溯的事件與來源；這是資料複查提醒，不判定工程過期、停工或完成，也不以網站整理日期代替核實。"
    },
    {
      "id": "profile-identity",
      "kind": "profile",
      "source": "data/site-profile.json",
      "ownerId": "public-records",
      "reviewTask": "依官方資訊重新確認任職狀態；不可依日曆自動推定結果。"
    },
    {
      "id": "platform-accountability",
      "kind": "platforms",
      "source": "data/platforms.json",
      "ownerId": "public-records",
      "reviewTask": "由本人或獲授權團隊補充政見目標、期限、權責及跨屆關聯；未知維持未知。"
    }
  ],
  "notificationPolicy": {
    "onlyNewOrChangedExpiredFindings": true,
    "onRecovery": "report_only",
    "unassignedOwner": "report_without_repeated_alert",
    "delivery": "GitHub Actions run status and summary only; no issue, email or chat sender"
  }
}
